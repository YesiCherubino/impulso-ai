NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
# Colocar true cuando backend/.env tiene DEMO_ACCESS_CODE
NEXT_PUBLIC_DEMO_REQUIRES_CODE=false

# Inicio de sesión real. Nunca guardar contraseñas en NEXT_PUBLIC_*.
NEXT_PUBLIC_AUTH_ENABLED=false
# Solo el servidor de Next.js puede leer esta URL privada.
API_BASE_URL=http://127.0.0.1:8001
