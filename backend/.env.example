# Copiar a backend/.env y usar valores propios. Nunca subir credenciales.
OPENAI_API_KEY=TU_CLAVE_PRIVADA
OPENAI_MODEL=gpt-4.1-mini
# Dejar PUBLIC_DEMO=false para desarrollo local sin acceso restringido.
# Configurar una clave privada antes de compartir el sitio.
PUBLIC_DEMO=false
DEMO_ACCESS_CODE=
AI_DAILY_LIMIT=12
# Dominio HTTPS del frontend al publicar (separar varios con comas)
CORS_ORIGINS=
